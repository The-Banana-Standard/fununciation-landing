---
import Base from '../layouts/Base.astro';
import { CONTACT_FORM_ACTION } from '../config';

const topics = ['A question', 'Feedback or an idea', "Something's not working", 'School or clinic'];
---

<Base
  page="contact"
  title="Contact · FUNunciation"
  description="Questions about FUNunciation, an idea for a game, or something not working? Send us a note."
>
  <section class="wrap contact">
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h1 class="display contact-title">Say the word.</h1>
      <p class="contact-lede">
        Questions about FUNunciation, an idea for a game, or a word you wish the app had? Send us a note and we'll write back.
      </p>
    </div>

    <div class="card">
      <form class="contact-form" method="post" action={CONTACT_FORM_ACTION ?? undefined} data-demo={CONTACT_FORM_ACTION ? undefined : ''}>
        <div class="field-row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <fieldset class="field">
          <legend>What's it about?</legend>
          <div class="pills">
            {
              topics.map((topic, i) => (
                <label class="pill">
                  <input type="radio" name="topic" value={topic} checked={i === 0} />
                  <span>{topic}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <div class="form-foot">
          <button type="submit" class="send">Send message <span aria-hidden="true">→</span></button>
          <p class="form-note">We'll only use your email to reply to you.</p>
        </div>
      </form>

      <div class="sent" tabindex="-1" hidden>
        <div class="sent-mark" aria-hidden="true">✓</div>
        <h2 class="display sent-title">Thanks! Message sent.</h2>
        <p class="sent-body">We'll write back to <strong data-sent-email></strong> soon.</p>
        <button type="button" class="again" data-send-another>Send another message</button>
      </div>
    </div>
  </section>
</Base>

<script>
  // With no CONTACT_FORM_ACTION set, nothing is sent: a valid submit just shows the thank-you state.
  const form = document.querySelector<HTMLFormElement>('.contact-form[data-demo]');
  const card = document.querySelector<HTMLElement>('.card');
  const sent = document.querySelector<HTMLElement>('.sent');

  if (form && card && sent) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      sent.querySelector('[data-sent-email]')!.textContent = String(new FormData(form).get('email'));
      card.style.minHeight = `${card.offsetHeight}px`;
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    });

    sent.querySelector('[data-send-another]')?.addEventListener('click', () => {
      form.reset();
      card.style.minHeight = '';
      sent.hidden = true;
      form.hidden = false;
      form.querySelector('input')?.focus();
    });
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 56px;
    align-items: start;
    padding: 56px var(--gutter) 120px;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 24px;
  }

  .contact-title {
    font-size: clamp(48px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -.01em;
    transform: rotate(-1.5deg);
    transform-origin: left;
  }

  .contact-lede {
    margin: 0;
    font-size: 21px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--ink-navy-2);
    max-width: 480px;
    text-wrap: pretty;
  }

  .card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--cream-surface);
    border: 3px solid var(--ink-navy);
    border-radius: 36px;
    padding: 40px;
    box-shadow: 10px 10px 0 var(--card-shadow);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .contact-form[hidden],
  .sent[hidden] {
    display: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  label,
  legend {
    padding: 0;
    font-weight: 800;
    font-size: 16px;
    color: var(--ink-navy);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    box-sizing: border-box;
    width: 100%;
    font: 600 18px var(--font-body);
    color: var(--ink-navy);
    background: var(--blush-field);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 14px 16px;
    transition:
      border-color 150ms ease-out,
      box-shadow 150ms ease-out;
  }

  textarea {
    min-height: 168px;
    line-height: 1.5;
    resize: vertical;
  }

  input[type='text']:focus,
  input[type='email']:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink-navy);
    box-shadow: 0 0 0 3px var(--card-shadow);
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: #8A3A3A;
  }

  /* Topic pills echo the chips on the app's setup screen: navy with a tick when chosen. */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .pill {
    position: relative;
    cursor: pointer;
  }

  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pill span {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--blush-field);
    font-weight: 800;
    font-size: 16px;
    color: var(--ink-navy-2);
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out;
  }

  .pill:hover span {
    border-color: var(--ink-navy);
  }

  .pill input:checked + span {
    background: var(--ink-navy);
    border-color: var(--ink-navy);
    color: var(--cream-surface);
  }

  .pill input:checked + span::before {
    content: '✓ ';
  }

  .pill input:focus-visible + span {
    outline: 3px solid var(--ink-navy);
    outline-offset: 3px;
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
    margin-top: 6px;
  }

  /* Coral is reserved for the App Store button, so the send button is navy with the card shadow,
     like the iPad frame on Home. */
  .send {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 22px;
    color: var(--cream-surface);
    background: var(--ink-navy);
    border: 0;
    border-radius: 999px;
    padding: 18px 30px;
    box-shadow: 0 6px 0 var(--card-shadow);
    transform: rotate(-1deg);
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform 150ms ease-out,
      box-shadow 150ms ease-out;
  }

  .send:hover {
    transform: rotate(-1deg) translateY(2px);
    box-shadow: 0 4px 0 var(--card-shadow);
  }

  .send:active {
    transform: rotate(-1deg) translateY(5px);
    box-shadow: 0 1px 0 var(--card-shadow);
  }

  .form-note {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-navy-2);
  }

  .sent {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 24px 0;
    outline: none;
  }

  /* The "got it" mark colours from the progress panel on Home. */
  .sent-mark {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #EEF5EA;
    border: 1.5px solid #CFE0C8;
    color: #3E5A39;
    font-weight: 900;
    font-size: 36px;
  }

  .sent-title {
    font-size: 40px;
    line-height: 1.08;
  }

  .sent-body {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--ink-navy-2);
    overflow-wrap: anywhere;
  }

  .sent-body strong {
    color: var(--ink-navy);
    font-weight: 800;
  }

  .again {
    margin-top: 8px;
    padding: 0;
    background: none;
    border: 0;
    font: 800 17px var(--font-body);
    color: var(--ink-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .again:hover {
    color: var(--link-hover);
  }

  @media (min-width: 768px) and (max-width: 1099px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .contact-copy {
      padding-top: 0;
    }

    .contact-lede {
      max-width: 560px;
    }

    .card {
      max-width: 640px;
    }
  }

  @media (max-width: 767px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding: 28px 20px 72px;
    }

    .contact-copy {
      gap: 22px;
      padding-top: 0;
    }

    .contact-title {
      font-size: 42px;
      line-height: 1.06;
      letter-spacing: normal;
    }

    .contact-lede {
      font-size: 18px;
      max-width: none;
    }

    .card {
      border-radius: 28px;
      padding: 24px 20px;
      box-shadow: 8px 8px 0 var(--card-shadow);
    }

    .contact-form {
      gap: 22px;
    }

    .field-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    input[type='text'],
    input[type='email'],
    textarea {
      font-size: 17px;
    }

    .pill span {
      padding: 9px 14px;
      font-size: 15px;
    }

    .form-foot {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .send {
      transform: none;
      font-size: 21px;
      padding: 18px 0;
    }

    .send:hover {
      transform: translateY(2px);
    }

    .send:active {
      transform: translateY(5px);
    }

    .form-note {
      text-align: center;
      font-size: 14px;
    }

    .sent-title {
      font-size: 30px;
    }

    .sent-body {
      font-size: 17px;
    }
  }
</style>
